# Copy to .env and replace the placeholders. Names and safe placeholders only.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/headless_dms
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
DOWNLOAD_TOKEN_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=5d
BASE_URL=http://localhost:3000
LOG_LEVEL=info
DOWNLOAD_LINK_EXPIRY=10m
BCRYPT_COST=10
MAX_UPLOAD_MB=5
DB_POOL_MAX=10

# only used by docker-compose for the Postgres container (the app builds DATABASE_URL from them)
POSTGRES_USER=dms
# use only URL-safe characters: the password is placed inside DATABASE_URL
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=dms
